generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model managers {
  manager_id                Int                     @id @default(autoincrement())
  name                      String                  @db.VarChar(100)
  email                     String                  @unique @db.VarChar(150)
  password                  String                  @db.VarChar(100)
  billing_email             String?                 @db.VarChar(150)
  subscription_plan         String?                 @db.VarChar(50)
  subscription_status       String?                 @db.VarChar(30)
  subscription_expires_at   DateTime?               @db.Timestamp(6)
  created_at                DateTime?               @default(now()) @db.Timestamp(6)
  shops                     shops[]
  subscription_payments     subscription_payments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ratings {
  rating_id  Int       @id @default(autoincrement())
  worker_id  Int?
  rating     Int?
  comment    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  workers    workers?  @relation(fields: [worker_id], references: [worker_id], onDelete: Cascade, onUpdate: NoAction)
}

model shops {
  shop_id      Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  location     String?   @db.VarChar(200)
  qr_code_link String?
  manager_id   Int?
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  managers     managers? @relation(fields: [manager_id], references: [manager_id], onDelete: Cascade, onUpdate: NoAction)
  workers      workers[]
}

model workers {
  worker_id  Int       @id @default(autoincrement())
  shop_id    Int?
  name       String    @db.VarChar(100)
  role       String?   @db.VarChar(100)
  photo_url  String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  ratings    ratings[]
  shops      shops?    @relation(fields: [shop_id], references: [shop_id], onDelete: Cascade, onUpdate: NoAction)
}

model subscription_payments {
  id                      Int       @id @default(autoincrement())
  manager_id              Int
  reference               String    @unique @db.VarChar(120)
  plan_id                 String    @db.VarChar(50)
  amount                  Int
  currency                String    @db.VarChar(10)
  provider                String    @db.VarChar(30)
  phone                   String    @db.VarChar(30)
  status                  String    @db.VarChar(30)
  paystack_transaction_id BigInt?
  paid_at                 DateTime? @db.Timestamp(6)
  expires_at              DateTime? @db.Timestamp(6)
  gateway_response        String?
  raw_response            Json?
  created_at              DateTime  @default(now()) @db.Timestamp(6)
  updated_at              DateTime  @updatedAt @db.Timestamp(6)
  managers                managers  @relation(fields: [manager_id], references: [manager_id], onDelete: Cascade, onUpdate: NoAction)
}
